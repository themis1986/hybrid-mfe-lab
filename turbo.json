{
  "$schema": "https://turborepo.com/schema.json",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "VITE_TODO_REMOTE_URL",
        "VITE_UI_VUE_DOCS_REMOTE_URL",
        "VITE_UI_REACT_DOCS_REMOTE_URL",
        "VITE_WEATHER_REMOTE_URL",
        "VITE_KANBAN_REMOTE_URL",
        "VITE_CRYPTO_REMOTE_URL",
        "VITE_BUDGET_REMOTE_URL",
        "VITE_MOCK_ACCOUNTS",
        "VITE_MAPBOX_TOKEN",
        "VITE_COINGECKO_API_KEY"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}

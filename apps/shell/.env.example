# Copy to .env.local (git-ignored) and edit. Vite loads it in dev, build and preview.
#
# VITE_MOCK_ACCOUNTS: the shell's mock sign-in accounts, a JSON array. Each account has:
# - id: stored in sessionStorage to restore the session on reload;
# - username, password: the credentials, in plain text;
# - name: shown in the app frame;
# - grants: what the account may open. Each grant is one of
#     { "kind": "all" }                       every app
#     { "kind": "tech", "tech": "vue" }       every app of one tech ("vue" or "react")
#     { "kind": "apps", "apps": ["<id>"] }    named apps, by their id in src/lib/navigation.ts
#
# The value is inlined into the shell's bundle: anyone with the page can read it. Use dev-only passwords.
VITE_MOCK_ACCOUNTS='[
  { "id": "u-admin", "username": "admin", "password": "admin", "name": "Ada Admin", "grants": [{ "kind": "all" }] },
  { "id": "u-react", "username": "react", "password": "react", "name": "Remy React", "grants": [{ "kind": "tech", "tech": "react" }] },
  { "id": "u-vue", "username": "vue", "password": "vue", "name": "Val Vue", "grants": [{ "kind": "tech", "tech": "vue" }] },
  { "id": "u-todo", "username": "todo", "password": "todo", "name": "Tess Todo", "grants": [{ "kind": "apps", "apps": ["todo"] }] }
]'
VITE_MAPBOX_TOKEN=<YOUR_MAPBOX_TOKEN>
{
  "name": "@repo/ui-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@lucide/vue": "catalog:",
    "@repo/chart-core": "workspace:*",
    "@repo/map-core": "workspace:*",
    "@repo/table-core": "workspace:*",
    "@tanstack/vue-table": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
